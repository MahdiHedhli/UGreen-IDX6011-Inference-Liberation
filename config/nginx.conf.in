worker_processes 1;
pid @@RUN_DIR@@/nginx.pid;
error_log stderr warn;

events { worker_connections 128; }

http {
    access_log off;
    server_tokens off;
    include @@CFG_DIR@@/auth.conf;

    map $status $auth_challenge {
        default "";
        401 'Bearer realm="ugreen-inference"';
    }

    client_body_temp_path @@RUN_DIR@@/client_temp;
    proxy_temp_path @@RUN_DIR@@/proxy_temp;
    fastcgi_temp_path @@RUN_DIR@@/fastcgi_temp;
    uwsgi_temp_path @@RUN_DIR@@/uwsgi_temp;
    scgi_temp_path @@RUN_DIR@@/scgi_temp;

    limit_conn_zone $server_name zone=inference_connections:1m;

    server {
        listen 127.0.0.1:@@PROXY_PORT@@;
        server_name _;
        client_max_body_size 8m;
        client_header_timeout 15s;
        client_body_timeout 60s;
        limit_conn inference_connections 2;
        limit_conn_status 429;

        add_header WWW-Authenticate $auth_challenge always;
        add_header Cache-Control "no-store" always;
        if ($inference_authorized = 0) { return 401; }

        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:@@GATEWAY_PORT@@;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers X-Accel-Redirect X-Accel-Buffering;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_next_upstream off;

        location = /v1/models {
            if ($request_method != GET) { return 405; }
            proxy_pass http://127.0.0.1:@@GATEWAY_PORT@@/v1/models;
        }
        location = /v1/chat/completions {
            if ($request_method != POST) { return 405; }
            proxy_pass http://127.0.0.1:@@GATEWAY_PORT@@/v1/chat/completions;
        }
        location / { return 404; }
    }
}
